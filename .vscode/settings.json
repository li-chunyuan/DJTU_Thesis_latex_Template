{
    // ==========================================================================
    // 1. 文件关联与排除 (File Associations & Excludes)
    // ==========================================================================
    "files.associations": {
        "*.tex": "latex",
        "*.cls": "latex",
        "*.sty": "latex",
        "*.bib": "bibtex"
    },
    "files.exclude": {
        "**/*.synctex.gz": true
    },

    // ==========================================================================
    // 2. LaTeX Workshop 设置 (LaTeX Environment)
    // ==========================================================================
    "[latex]": {
        "editor.formatOnPaste": false,
        "editor.suggestSelection": "recentlyUsedByPrefix"
    },

    // ===================================================================
    // 一、 预览、同步与界面
    // ===================================================================
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.view.pdf.internal.synctex.keybinding": "double-click",
    "latex-workshop.synctex.afterBuild.enabled": true,
    "latex-workshop.view.pdf.zoom": "page-width",
    "latex-workshop.view.pdf.scrollMode": 0,
    "latex-workshop.view.pdf.spreadMode": 0,
    "latex-workshop.view.pdf.tab.editorGroup": "right",
    "latex-workshop.view.pdf.hand": false,
    "latex-workshop.view.pdf.trim": 0,
    "latex-workshop.view.pdf.reload.transition": "fade",
    "latex-workshop.showContextMenu": true,
    "latex-workshop.intellisense.package.enabled": true,
    "latex-workshop.message.error.show": false,
    "latex-workshop.message.warning.show": false,
    "latex-workshop.message.information.show": false,

    // ===================================================================
    // 二、 输出与构建策略
    // ===================================================================
    "latex-workshop.latex.outDir": "%DIR%/out",
    "latex-workshop.latex.build.forceRecipeUsage": true,
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.watch.pdf.delay": 800,

    // ===================================================================
    // 三、 Root 识别（多文件工程）
    // ===================================================================
    "latex-workshop.latex.rootFile.useSubFile": true,
    "latex-workshop.latex.rootFile.doNotPrompt": true,
    "latex-workshop.latex.search.rootFiles.include": [
        "**/*.tex"
    ],
    "latex-workshop.latex.search.rootFiles.exclude": [
        "**/.git/**",
        "**/node_modules/**",
        "**/.history/**",
        "**/.vscode/**",
        "out/**",
        "latex/**"
    ],

    // ===================================================================
    // 四、 工具链（Tools）定义
    // ===================================================================
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-aux-only",
            "command": "latexmk",
            "args": [
                "-xelatex",
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-auxdir=%DIR%/out",
                "-outdir=%DIR%/out",
                "-emulate-aux-dir",
                "%DOC%"
            ]
        },
        {
            "name": "latexmk (xelatex)",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-xelatex",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "latexmk (pdflatex)",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-pdf",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "latexmk (lualatex)",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-lualatex",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "latexmk (xelatex + shell-escape)",
            "command": "latexmk",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-xelatex",
                "-shell-escape",
                "-outdir=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "xelatex",
            "command": "xelatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "lualatex",
            "command": "lualatex",
            "args": [
                "-synctex=1",
                "-interaction=nonstopmode",
                "-file-line-error",
                "-output-directory=%OUTDIR%",
                "%DOC%"
            ]
        },
        {
            "name": "biber",
            "command": "biber",
            "args": [
                "%OUTDIR%/%DOCFILE%"
            ]
        },
        {
            "name": "bibtex",
            "command": "bibtex",
            "args": [
                "%OUTDIR%/%DOCFILE%"
            ]
        },
        {
            "name": "makeglossaries",
            "command": "makeglossaries",
            "args": [
                "%OUTDIR%/%DOCFILE%"
            ]
        },
        {
            "name": "makeindex",
            "command": "makeindex",
            "args": [
                "%OUTDIR%/%DOCFILE%"
            ]
        },
        {
            "name": "tectonic (basic)",
            "command": "tectonic",
            "args": [
                "--synctex",
                "--keep-logs",
                "--keep-intermediates",
                "--outdir",
                "%OUTDIR%",
                "%DOC%.tex"
            ]
        },
        {
            "name": "arara",
            "command": "arara",
            "args": [
                "--verbose",
                "--log",
                "--working-directory",
                "%DIR%",
                "%DOC%.tex"
            ]
        },
        {
            "name": "ensure-out-dirs",
            "command": "cmd",
            "args": [
                "/c",
                "robocopy \"%DIR%\" \"%OUTDIR%\" /E /XF * /XD out .git .vscode .history & exit 0"
            ]
        },
        {
            "name": "copy-pdf-to-root",
            "command": "powershell",
            "args": [
                "-NoProfile",
                "-Command",
                "$doc = '%DOCFILE%'; $dir = '%DIR%'; $out = '%OUTDIR%'; $synctex = \"$dir\\$doc.synctex.gz\"; if (Test-Path \"$out\\$doc.pdf\") { Copy-Item \"$out\\$doc.pdf\" \"$dir\\$doc.pdf\" -Force }; if (Test-Path \"$out\\$doc.synctex.gz\") { Copy-Item \"$out\\$doc.synctex.gz\" $synctex -Force }; if (Test-Path $synctex) { (Get-Item -LiteralPath $synctex).Attributes = 'Hidden' }"
            ]
        }
    ],

    // ===================================================================
    // 五、 配方（Recipes）组合
    // ===================================================================
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk ▶ PDF（aux→out, pdf→root）",
            "tools": [
                "ensure-out-dirs",
                "latexmk-aux-only",
                "copy-pdf-to-root"
            ]
        },
        {
            "name": "latexmk: xelatex（推荐）",
            "tools": [
                "ensure-out-dirs",
                "latexmk (xelatex)",
                "copy-pdf-to-root"
            ]
        },
        {
            "name": "latexmk: pdflatex",
            "tools": [
                "latexmk (pdflatex)"
            ]
        },
        {
            "name": "latexmk: lualatex",
            "tools": [
                "latexmk (lualatex)"
            ]
        },
        {
            "name": "latexmk: xelatex（shell-escape）",
            "tools": [
                "latexmk (xelatex + shell-escape)"
            ]
        },
        {
            "name": "latexmk → makeglossaries → latexmk",
            "tools": [
                "latexmk (xelatex)",
                "makeglossaries",
                "latexmk (xelatex)"
            ]
        },
        {
            "name": "latexmk → makeindex → latexmk",
            "tools": [
                "latexmk (xelatex)",
                "makeindex",
                "latexmk (xelatex)"
            ]
        },
        {
            "name": "手动：xelatex → biber → xelatex×2",
            "tools": [
                "xelatex",
                "biber",
                "xelatex",
                "xelatex"
            ]
        },
        {
            "name": "手动：pdflatex → bibtex → pdflatex×2",
            "tools": [
                "pdflatex",
                "bibtex",
                "pdflatex",
                "pdflatex"
            ]
        },
        {
            "name": "单次：xelatex",
            "tools": [
                "xelatex"
            ]
        },
        {
            "name": "单次：pdflatex",
            "tools": [
                "pdflatex"
            ]
        },
        {
            "name": "单次：lualatex",
            "tools": [
                "lualatex"
            ]
        },
        {
            "name": "tectonic（快速出活）",
            "tools": [
                "tectonic (basic)"
            ]
        },
        {
            "name": "arara（按文档头部规则）",
            "tools": [
                "arara"
            ]
        }
    ],
    "latex-workshop.latex.recipe.default": "lastUsed",

    // ===================================================================
    // 六、 自动清理（Clean）
    // ===================================================================
    "latex-workshop.latex.autoClean.run": "onBuilt",
    "latex-workshop.latex.clean.method": "glob",
    "latex-workshop.latex.clean.fileTypes": [
        "*.aux",
        "*.log",
        "*.toc",
        "*.lof",
        "*.lot",
        "*.out",
        "*.fls",
        "*.fdb_latexmk",
        "*.bbl",
        "*.bcf",
        "*.blg",
        "*.run.xml",
        "*.idx",
        "*.ind",
        "*.ilg",
        "*.ist",
        "*.acn",
        "*.acr",
        "*.alg",
        "*.glg",
        "*.glo",
        "*.gls",
        "*.snm",
        "*.nav",
        "*.vrb",
        "*.xdv",
        "_minted-*/**",
        "_minted-*/",
        "*.auxlock"
    ],

    // ===================================================================
    // 七、 语法检查（Linting）
    // ===================================================================
    "latex-workshop.linting.chktex.enabled": true,
    "latex-workshop.linting.lacheck.enabled": false,
    "latex-workshop.linting.run": "onType",

    // ===================================================================
    // 八、 格式化（Formatting）
    // ===================================================================
    "latex-workshop.formatting.latex": "latexindent",
    "latex-workshop.formatting.latexindent.path": "latexindent",
    "latex-workshop.formatting.latexindent.args": [
        "-c",
        "%DIR%/",
        "%TMPFILE%",
        "-y=defaultIndent: '%INDENT%'"
    ],

    // ===================================================================
    // 九、 词数统计（Word Count）
    // ===================================================================
    "latex-workshop.texcount.autorun": "onSave",
    "latex-workshop.texcount.args": [
        "-merge",
        "-inc",
        "-total",
        "-ch",
        "-utf8"
    ],

    // ===================================================================
    // 十、 智能感知与大纲
    // ===================================================================
    "latex-workshop.intellisense.update.aggressive.enabled": true,
    "latex-workshop.intellisense.update.delay": 800,
    "latex-workshop.hover.preview.enabled": true,
    "latex-workshop.hover.ref.enabled": true,
    "latex-workshop.hover.citation.enabled": true,
    "latex-workshop.bind.enter.key": true,
    "latex-workshop.view.outline.enabled": true,
    "latex-workshop.view.outline.sections": [
        "part",
        "chapter",
        "section",
        "subsection",
        "subsubsection",
        "paragraph"
    ],
    "latex-workshop.view.outline.floats.enabled": true,

    // ===================================================================
    // 十一、 外部依赖查找
    // ===================================================================
    "latex-workshop.kpsewhich.bibtex.enabled": true,
    "latex-workshop.kpsewhich.class.enabled": true,
    "latex-workshop.latex.bibDirs": [
        "%DIR%/bib"
    ]
}